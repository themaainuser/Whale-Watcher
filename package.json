{
  "name": "whale-watcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/migrate.ts",
    "import": "tsx src/importers/run.ts",
    "start": "tsx src/index.ts",
    "test": "npm run test:unit && npm run test:db",
    "test:unit": "tsx --test test/unit.test.ts test/webhook.test.ts",
    "test:db": "tsx --test test/db.test.ts"
  },
  "dependencies": {
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "pg": "^8.12.0",
    "xrpl": "^4.2.0",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
